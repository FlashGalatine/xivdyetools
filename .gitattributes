# Normalize all text files to LF in the repository and working tree.
# Keeps line endings deterministic across platforms (avoids autocrlf churn on
# Windows/OneDrive, where files can otherwise show as "modified" with no real diff).
# Binary files are auto-detected by `text=auto` and left untouched.
* text=auto eol=lf

# Ensure lockfile always uses LF line endings (pnpm YAML parser requires it)
pnpm-lock.yaml text eol=lf

# Generated ko/zh/ja equipment-name tables (apps/api-worker/scripts/build-item-names.mjs):
# ~1-1.5 MB single-line JSON each — keep them out of diffs and language stats.
apps/api-worker/src/chara/data/item-names.*.json linguist-generated=true -diff
# Generated GPOSERS acquisition table (apps/api-worker/scripts/build-acquisition.ts)
apps/api-worker/src/chara/data/acquisition.en.json linguist-generated=true -diff

# Retained upstream legal text and unified-diff context keep their own whitespace.
# LF normalization still applies; application source keeps the normal checks.
apps/image-worker/vendor/photon/licenses/** whitespace=-blank-at-eol,-blank-at-eof
apps/image-worker/vendor/photon/ownership.patch whitespace=-blank-at-eol
