{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_APP_ENV"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.build.json",
        "package.json"
      ]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["src/**", "tsconfig.json"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["src/**", "eslint.config.*", "knip.jsonc"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      // scripts/**/*.js holds the CI-gate scripts (e.g. web-app's deploy smoke
      // test) and their tests, so it must invalidate the cache like src/** does.
      // Narrowed to *.js (matching what vitest's include actually discovers) so
      // non-JS assets under scripts/ (e.g. icon PNGs) do not bust the cache.
      "inputs": ["src/**", "tests/**", "scripts/**/*.js", "vitest.config.*"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": ["src/**", "tests/**", "vitest.config.*"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "deploy": {
      "dependsOn": ["build", "type-check"],
      "cache": false,
      "persistent": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
