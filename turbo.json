{
  "$schema": "https://turbo.build/schema.json",

  // Shared files that every workspace's tasks depend on but none of them
  // contains, so no per-package `inputs` glob can reach them. A change here
  // busts every task in every workspace, which is the correct blast radius:
  //
  //  - `tsconfig.base.json` — every workspace tsconfig extends it, and since
  //    the 2026-09-01 dead-code audit removed the four local overrides it is
  //    the SOLE source of `noUnusedLocals`. Unhashed, turning that off left
  //    every type-check cache valid and the gate reported green without tsc
  //    ever re-running.
  //  - `eslint.config.js` — every workspace but `apps/web-app` inherits the
  //    root flat config by upward resolution, so editing a rule here changed
  //    what sixteen workspaces' `lint` reports while hashing nothing.
  //  - `pnpm-workspace.yaml` — holds the dependency overrides and the
  //    supply-chain `minimumReleaseAge` window, so it changes what every
  //    workspace actually builds against.
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js", "pnpm-workspace.yaml"],

  "tasks": {
    // ---------------------------------------------------------------------
    // A NOTE ON `$TURBO_DEFAULT$`, which the four gating tasks below all use.
    //
    // These `inputs` lists used to be hand-maintained allowlists, and they
    // were wrong four separate times — each fix pattern-matched the previous
    // one and each time a NEW directory was missed:
    //   `scripts/**/*.js` (test), then `wrangler.toml` (test), then
    //   `tests/**` + `scripts/**` (type-check and lint), and finally
    //   `packages/test-utils/integration/**` + `apps/api-worker/docs/**`,
    //   found by the 2026-09-01 review AFTER the audit that fixed the others.
    // Every one of those was the same bug: a task read a file no glob named,
    // so the edit that would break the task could not invalidate its cache
    // and turbo replayed a green it had not earned.
    //
    // `$TURBO_DEFAULT$` inverts the default. It hashes every git-tracked file
    // in the package, so a directory added tomorrow is covered without anyone
    // remembering to add it, and the allowlist can no longer silently drift
    // behind the code. Un-tracked build artefacts (`dist/`, `coverage/`) are
    // gitignored and so are never hashed.
    //
    // The cost is real and accepted: editing a workspace's README or CLAUDE.md
    // now busts its caches. That is the correct trade for a task whose whole
    // job is to be a gate — a false green is far more expensive than a cache
    // miss. Anything CROSS-package still has to be named explicitly, because
    // `$TURBO_DEFAULT$` only ever covers the package it runs in.
    // ---------------------------------------------------------------------

    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_APP_ENV"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$"]
    },

    "type-check": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"]
    },

    "lint": {
      "dependsOn": ["^build"],
      "cache": true,
      // Sixteen of the seventeen workspaces are dead-code gated — every
      // package and every app but the parked `apps/stoat-worker` — with knip
      // running inside `lint`. Fourteen do it via a `lint:dead` script running
      // `knip --directory ../.. --workspace <ws>` against the ROOT knip.jsonc;
      // `apps/web-app` and `apps/og-worker` call a bare `knip` against their
      // own. Hence `$TURBO_ROOT$/knip.jsonc` below: editing it changes what
      // fourteen workspaces report, and it lives in none of them.
      //
      // NOTE what no `inputs` list can fix: the root gate reads the WHOLE
      // monorepo graph, so a dependent workspace dropping an import can turn a
      // package export dead without touching that package at all, and turbo
      // will still serve that package a cached green. `pnpm lint:dead` at the
      // root is the cross-check; as of 2026-09-01 it reports exactly three
      // known `apps/web-app` config-scope artifacts (2 unused `.d.ts` files
      // and 1 kept `wrangler` devDependency, all ignored by web-app's own
      // knip.jsonc). If that count ever moves, something real changed.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/knip.jsonc"]
    },

    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      // `presets-api`, `oauth`, `moderation-worker` and `image-worker` each
      // have wrangler-config tests that read their OWN toml and at least one
      // SIBLING's, which `$TURBO_DEFAULT$` cannot see. The glob below is
      // deliberately blunt: any app's wrangler.toml edit busts every
      // workspace's test cache, because no narrower pattern covers the
      // cross-package reads while `inputs` stays one shared definition. A
      // per-package Turborepo config (`"extends": ["//"]`) could let each of
      // the four name only the pairs it reads; the repo uses none today and
      // the shared glob was kept as the simpler choice.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/*/wrangler.toml"],
      "outputs": ["coverage/**"]
    },

    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    },

    "clean": {
      "cache": false
    },

    "deploy": {
      "dependsOn": ["build", "type-check"],
      "cache": false,
      "persistent": false
    },

    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
