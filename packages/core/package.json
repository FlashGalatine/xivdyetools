{
  "name": "@xivdyetools/core",
  "version": "4.0.0",
  "description": "Core color algorithms and dye database for XIV Dye Tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blending": {
      "types": "./dist/blending/index.d.ts",
      "import": "./dist/blending/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:locales && tsc -p tsconfig.build.json && npm run copy:locales",
    "build:locales": "tsx scripts/build-locales.ts",
    "copy:locales": "tsx scripts/copy-locales.ts",
    "calibrate:bands": "tsx scripts/calibrate-bands.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/__tests__/integration",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src && pnpm run lint:dead",
    "lint:dead": "knip --directory ../.. --workspace packages/core --no-config-hints --no-tag-hints",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ffxiv",
    "final-fantasy-xiv",
    "color",
    "dye",
    "harmony",
    "accessibility",
    "colorblind",
    "color-theory",
    "rgb",
    "hsv",
    "universalis"
  ],
  "author": "Flash Galatine",
  "license": "MIT",
  "homepage": "https://github.com/FlashGalatine/xivdyetools#readme",
  "bugs": {
    "url": "https://github.com/FlashGalatine/xivdyetools/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FlashGalatine/xivdyetools.git",
    "directory": "packages/core"
  },
  "dependencies": {
    "@xivdyetools/logger": "workspace:*",
    "@xivdyetools/types": "workspace:*",
    "spectral.js": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "csv-parse": "^7.0.1",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
