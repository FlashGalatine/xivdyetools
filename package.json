{
  "name": "xivdyetools",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:dead": "knip",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "eslint": "^10.8.0",
    "knip": "^6.32.2",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.64.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.17.0"
}
