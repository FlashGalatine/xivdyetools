{
  "name": "xivdyetools",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:dead": "knip",
    "type-check": "turbo run type-check",
    "type-check:scripts": "tsc -p scripts/tsconfig.json",
    "coverage:report": "tsx scripts/coverage-report.ts",
    "dead-code:check": "tsx scripts/check-dead-code.ts",
    "test:scripts": "tsx --test scripts/check-dead-code.test.ts scripts/knip-config.test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "eslint": "^10.9.1",
    "knip": "^6.33.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "typescript-eslint": "^8.68.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.2",
    "tsx": "^4.23.12"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.17.0"
}
