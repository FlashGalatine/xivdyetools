{
  "name": "xivdyetools-oauth-worker",
  "version": "3.2.0",
  "private": true,
  "description": "Discord OAuth2 + JWT issuance for XIV Dye Tools",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ && pnpm run lint:dead",
    "lint:dead": "knip --directory ../.. --workspace apps/oauth --no-config-hints --no-tag-hints",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@xivdyetools/auth": "workspace:*",
    "@xivdyetools/types": "workspace:*",
    "@xivdyetools/worker-kit": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@xivdyetools/test-utils": "workspace:*",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
