{
  "name": "xivdyetools-moderation-worker",
  "version": "1.6.0",
  "private": true,
  "description": "XIV Dye Tools Discord Moderation Bot - Cloudflare Workers Edition",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "register-commands": "npx tsx scripts/register-commands.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "ffxiv",
    "cloudflare-workers",
    "moderation"
  ],
  "author": "Flash Galatine",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@xivdyetools/auth": "workspace:*",
    "@xivdyetools/bot-logic": "workspace:*",
    "@xivdyetools/logger": "workspace:*",
    "@xivdyetools/types": "workspace:*",
    "@xivdyetools/worker-kit": "workspace:*",
    "hono": "^4.13.4"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@xivdyetools/test-utils": "workspace:*",
    "discord-interactions": "^4.4.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
