{
  "name": "xivdyetools-moderation-worker",
  "version": "1.7.4",
  "private": true,
  "description": "XIV Dye Tools Discord Moderation Bot - Cloudflare Workers Edition",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ && pnpm run lint:dead",
    "lint:dead": "knip --directory ../.. --workspace apps/moderation-worker --no-config-hints --no-tag-hints",
    "register-commands": "npx tsx scripts/register-commands.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "ffxiv",
    "cloudflare-workers",
    "moderation"
  ],
  "author": "Flash Galatine",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@xivdyetools/auth": "workspace:*",
    "@xivdyetools/bot-logic": "workspace:*",
    "@xivdyetools/logger": "workspace:*",
    "@xivdyetools/types": "workspace:*",
    "@xivdyetools/worker-kit": "workspace:*",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@xivdyetools/test-utils": "workspace:*",
    "dotenv": "^18.0.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
