{
  "name": "xivdyetools-presets-api",
  "version": "2.4.0",
  "private": true,
  "description": "Cloudflare Worker API for XIV Dye Tools Community Presets",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "db:migrate": "wrangler d1 execute xivdyetools-presets --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute xivdyetools-presets --local --file=./schema.sql",
    "db:migrate:indexes": "wrangler d1 execute xivdyetools-presets --remote --file=./migrations/002_add_composite_indexes.sql",
    "db:seed": "npx tsx scripts/migrate-presets.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ && pnpm run lint:dead",
    "lint:dead": "knip --directory ../.. --workspace apps/presets-api --no-config-hints --no-tag-hints",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@xivdyetools/auth": "workspace:*",
    "@xivdyetools/types": "workspace:*",
    "@xivdyetools/worker-kit": "workspace:*",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "@xivdyetools/test-utils": "workspace:*",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
