{
  "name": "xivdyetools-web-app",
  "version": "5.3.0",
  "private": true,
  "description": "A comprehensive web-based toolset for Final Fantasy XIV players",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src && knip",
    "lint:dead": "knip",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:coverage": "cross-env PLAYWRIGHT_PROJECT_NAME=chromium-coverage playwright test --project=chromium-coverage",
    "test:e2e:comparison": "playwright test dye-comparison.spec.ts",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "check-bundle-size": "node scripts/check-bundle-size.js",
    "validate:i18n": "node scripts/validate-i18n.js && node scripts/i18n-parity.mjs",
    "i18n:unused": "node scripts/analyze-unused-keys.js",
    "build:check": "npm run build && npm run check-bundle-size"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@xivdyetools/core": "workspace:*",
    "@xivdyetools/logger": "workspace:*",
    "@xivdyetools/svg": "workspace:*",
    "@xivdyetools/types": "workspace:*",
    "lit": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
