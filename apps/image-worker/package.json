{
  "name": "xivdyetools-image-worker",
  "version": "1.1.0",
  "private": true,
  "description": "XIV Dye Tools Image Worker - photon-backed image decode and pixel extraction",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "license": "MIT",
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@xivdyetools/worker-kit": "workspace:*",
    "hono": "^4.13.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "@types/node": "^26.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
