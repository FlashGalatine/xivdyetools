{
  "name": "xivdyetools-api-worker",
  "version": "0.14.6",
  "private": true,
  "description": "Public API for XIV Dye Tools - Dye database and color matching",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "docs:dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "build:docs": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.docs.json",
    "lint": "eslint src/ && pnpm run lint:dead",
    "lint:dead": "knip --directory ../.. --workspace apps/api-worker --no-config-hints --no-tag-hints",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@xivdyetools/core": "workspace:*",
    "@xivdyetools/types": "workspace:*",
    "@xivdyetools/worker-kit": "workspace:*",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "vitepress": "^1.6.4",
    "vue": "^3.5.43",
    "@xivdyetools/svg": "workspace:*",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@xivdyetools/test-utils": "workspace:*",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
