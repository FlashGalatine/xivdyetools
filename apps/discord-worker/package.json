{
  "name": "xivdyetools-discord-worker",
  "version": "5.6.3",
  "private": true,
  "description": "XIV Dye Tools Discord Bot - Cloudflare Workers Edition",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "check-bundle-size": "node scripts/check-bundle-size.mjs",
    "lint": "eslint src/ && pnpm run lint:dead",
    "lint:dead": "knip --directory ../.. --workspace apps/discord-worker --no-config-hints --no-tag-hints",
    "register-commands": "npx tsx scripts/register-commands.ts",
    "upload-emojis": "npx tsx scripts/upload-emojis.ts"
  },
  "keywords": ["discord", "bot", "ffxiv", "cloudflare-workers"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@xivdyetools/auth": "workspace:*",
    "@xivdyetools/bot-logic": "workspace:*",
    "@xivdyetools/svg": "workspace:*",
    "@xivdyetools/core": "workspace:*",
    "@xivdyetools/logger": "workspace:*",
    "@xivdyetools/types": "workspace:*",
    "@xivdyetools/worker-kit": "workspace:*",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@xivdyetools/test-utils": "workspace:*",
    "dotenv": "^18.0.0",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
