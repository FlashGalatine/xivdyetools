{
  "name": "xivdyetools-og-worker",
  "version": "2.12.0",
  "private": true,
  "description": "XIV Dye Tools OpenGraph Worker - Dynamic social media previews for shared dye tool links",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "knip && knip --production",
    "lint:dead": "knip",
    "lint:dead:prod": "knip --production"
  },
  "keywords": ["cloudflare-workers", "opengraph", "ffxiv", "dye-tools"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@xivdyetools/core": "workspace:*",
    "@xivdyetools/svg": "workspace:*",
    "@xivdyetools/types": "workspace:*",
    "@xivdyetools/worker-kit": "workspace:*",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
